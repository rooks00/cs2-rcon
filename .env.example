# Required on Vercel. Enter the same key in Relay's connection screen.
RCON_RELAY_SECRET=replace-with-a-long-random-value

# Optional defense-in-depth. Comma-separated hosts or wildcard subdomains.
# RCON_ALLOWED_HOSTS=203.0.113.10,cs2.example.com,*.games.example.com

# Optional; defaults to 6000ms and is capped at 15000ms.
# RCON_TIMEOUT_MS=6000

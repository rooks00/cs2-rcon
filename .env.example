# No environment variables or extra access key are required to connect.
# Visitors enter their CS2 hostname, TCP port and RCON password.

# Optional: public origin when an HTTPS reverse proxy forwards to HTTP Node.
# RCON_PUBLIC_ORIGIN=https://relay.example.com

# Optional: restrict this installation to specific destinations.
# RCON_ALLOWED_HOSTS=cs2.example.com,*.games.example.com
# RCON_ALLOWED_PORTS=27015,27016

# Optional: reach LAN/loopback servers from a trusted self-hosted installation.
# Requires the exact host in RCON_ALLOWED_HOSTS (wildcards do not grant LAN access).
# RCON_ALLOW_PRIVATE=true
# RCON_ALLOWED_HOSTS=192.168.1.50

# Optional: TCP operation timeout, 1000–15000 milliseconds. Default: 6000.
# RCON_TIMEOUT_MS=6000

# Optional: private installation access control. Leave unset for keyless access.
# Setting this intentionally makes the connection form ask for an extra key.
# RCON_RELAY_SECRET=your-optional-installation-key

# Development permits LAN/loopback targets by default. Disable to test public mode.
# RCON_ALLOW_PRIVATE_DEV=false
